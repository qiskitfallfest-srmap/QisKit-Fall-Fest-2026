NEXT_PUBLIC_SITE_URL=https://www.qffsrmap2026.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# HMAC key for the qff_auth_session cookie (required in production, >= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every user out.
SESSION_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEMINI_API_KEY=

# Error alerts: Discord or Slack incoming webhook URL (optional)
ALERT_WEBHOOK_URL=

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CERTIFICATE_PRICE_INR=499
 
# Qiskit Coding Challenge Execution Service
QISKIT_JUDGE_URL=http://localhost:8000
QISKIT_JUDGE_SECRET=

# Google Form & Apps Script Automated Webhook Sync Secret
GOOGLE_FORM_SYNC_SECRET=qff-srmap-2026-sync-secret

# Google Apps Script Web App Relay URL (for website registrations to trigger confirmation emails)
GOOGLE_APPS_SCRIPT_WEBAPP_URL=
